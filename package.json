{
  "name": "memoryx",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/generate-client.cjs",
    "dev": "next dev",
    "build": "next build",
    "build:vercel": "node scripts/vercel-build.cjs",
    "start": "next start",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.cjs",
    "test:e2e": "node scripts/browser-check.cjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --env-file=.env prisma/seed.cjs",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "5.20.0",
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5",
    "lucide-react": "1.54.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.7",
    "playwright": "1.64.0",
    "prisma": "5.20.0",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  },
  "prisma": {
    "seed": "node prisma/seed.cjs"
  }
}
